{
  "manifest_version": 3,
  "name": "Hover Actions for SPL",
  "version": "0.7.1",
  "description": "Macro and lookup hover popups, a lookup clause builder with live sample preview, and copy-to-clipboard icons across Splunk Web.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "https://*.splunkcloud.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.splunkcloud.com/*"],
      "js": ["page-agent.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*.splunkcloud.com/*"],
      "js": ["content.js"],
      "css": ["popup.css"],
      "run_at": "document_idle"
    }
  ]
}
