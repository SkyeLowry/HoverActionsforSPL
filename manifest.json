{
  "manifest_version": 3,
  "name": "Hover Actions for SPL",
  "version": "0.20.1",
  "description": "Hover popups, a lookup clause builder, and one-click copying for Splunk Web. No site access until you add your own domain.",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
